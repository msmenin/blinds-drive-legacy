{
  "name": "blinds-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && if [ -f wrangler.local.jsonc ]; then wrangler deploy -c wrangler.local.jsonc; else wrangler deploy; fi"
  },
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.21",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
